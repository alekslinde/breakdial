{
  "name": "breakdial",
  "version": "0.1.0",
  "description": "One dial (0-10) that breaks anything \u2014 from UI jank to backend outage. Re-exports @breakdial/core.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "breakdial": "./dist/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "chaos",
    "fault-injection",
    "testing",
    "resilience"
  ],
  "dependencies": {
    "@breakdial/core": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alekslinde/breakdial.git",
    "directory": "packages/breakdial"
  },
  "homepage": "https://github.com/alekslinde/breakdial#readme",
  "bugs": "https://github.com/alekslinde/breakdial/issues",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
