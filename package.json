{
  "name": "breakdial-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for breakdial. Not published — the published root package is packages/breakdial.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --force",
    "smoke": "node ./scripts/smoke.mjs",
    "license:check": "node ./scripts/check-license.mjs",
    "test": "npm run build && npm run smoke"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.6.3"
  }
}
