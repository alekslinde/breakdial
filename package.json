{
  "name": "breakdial-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for breakdial. Not published \u2014 the published root package is packages/breakdial.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && npm run postbuild:bin",
    "postbuild:bin": "node -e \"for (const f of ['packages/breakdial/dist/cli.js','packages/mcp/dist/bin.js']) require('node:fs').chmodSync(f, 0o755)\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "smoke": "node ./scripts/smoke.mjs",
    "license:check": "node ./scripts/check-license.mjs",
    "check:tarballs": "node ./scripts/check-tarballs.mjs",
    "check:node-floor": "node ./scripts/check-node-floor.mjs",
    "test": "npm run build && npm run smoke && npm run license:check && npm run check:tarballs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.6.3"
  }
}
